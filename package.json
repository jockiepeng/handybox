{
  "name": "handybox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "verify": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "astro": "^7.4.5",
    "cron-parser": "^5.10.3",
    "cronstrue": "^3.38.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "exifr": "^7.1.3",
    "he": "^2.0.0",
    "lossless-json": "^4.3.3",
    "luxon": "^3.7.2",
    "marked": "^18.1.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
